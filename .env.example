# Server Configuration
PORT=3001

# Ollama Local Configuration
# MacBook Pro M4 local instance
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:32b

# TTS Engine: 'browser' (dynamic low-latency client synth) | 'say' (macOS native fast streamer)
TTS_ENGINE=browser

# Voice Activity Detection (VAD) Sensitivity
VAD_ENERGY_THRESHOLD=0.035
VAD_SILENCE_TIMEOUT_MS=750
