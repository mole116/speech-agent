{
  "name": "local-voice-agent",
  "version": "1.0.0",
  "description": "Local, low-latency, free Voice Agent running on MacBook Pro M4 with Ollama and Vercel AI SDK",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc && vite build",
    "test": "tsx --test tests/echoFilter.test.ts tests/sentenceSegmenter.test.ts tests/tools.test.ts tests/vad.test.ts tests/protocol.test.ts",
    "eval": "tsx tests/evals.ts",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "ai": "^4.0.0",
    "ollama-ai-provider": "^1.2.0",
    "@ai-sdk/openai": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
